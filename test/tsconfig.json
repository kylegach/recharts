{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "noEmit": true,
    "target": "es2023",
    "types": ["node", "vitest/globals"],
    /* Disable noUncheckedIndexedAccess in tests - fixing all array access would be a large undertaking */
    "noUncheckedIndexedAccess": false
  },
  "include": ["./**/*", "../types.d.ts", "./helper/toBeRechartsScale.ts", "./helper/expectFunctionReturning.ts"],
  /*
   * Browser Mode tests have their own program in component/tsconfig.json.
   * vitest/browser bundles its own jest-dom matcher types, which conflict with @testing-library/jest-dom.
   */
  "exclude": ["./component/**/*.spec.ts", "./component/**/*.spec.tsx", "./helper/browser/**/*"]
}
